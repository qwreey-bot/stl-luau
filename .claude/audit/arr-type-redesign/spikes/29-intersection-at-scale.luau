type Arr<T> = Data<T> & ArrIfce
local x = (nil :: any) :: Arr<number>
local mapped = x:Map(function(v: number)
	return tostring(v)
end)
local chained = x:Map(function(v: number)
	return tostring(v)
end):Map(function(s: string)
	return #s > 0
end)
local neg1: number = mapped[1]
local neg2: string = chained[1]
local neg3 = x:NoSuchMethod()
local canary: string = 42
return { mapped, chained, neg1, neg2, neg3, canary }
