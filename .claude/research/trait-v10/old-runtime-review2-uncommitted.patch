+print("=== 3. 리뷰 2라운드 (2026-10-14) — 도는 중의 GC, 물려받은 재정의와 ops ===")
+do
+	const T = stl.Trait
+	-- (1) ⭐ 약한 테이블(토큰·트레이트·표식)을 돌며 표를 짓는 동안 GC 가 테이블을 다시 잡으면 살아 있는 종류를 건너뛰었음
+	-- (만들었다 버린 종류가 수천 개면 사용자 종류의 20~25% 가 영영 빠짐 — 조회는 만들지 않으니 다시 안 생김).
+	-- GC 시점이라 한 번으로는 우연일 수 있어 여러 판을 돕니다(고치기 전엔 판마다 수십 개씩 빠졌음).
+	for round = 1, 4 do
+		const live = {}
+		for i = 1, 200 do
+			const tok = T.NewToken(`Live{round}-{i}`)
+			T.Impl(
+				stl.Collection,
+				tok,
+				{
+					Len = function(): number
+						return 0
+					end,
+					Clear = function() end,
+				} :: any
+			)
+			table.insert(live, tok)
+		end
+		for _ = 1, 2000 do
+			T.NewToken("Temp")
+		end
+		const Describe = T.New(
+			`Describe{round}`,
+			{
+				dependencies = { stl.Collection :: any },
+				defaults = function(_ops: any, deps: any)
+					-- 만드는 함수가 조금 할당하면(보통의 기본 구현도 클로저를 만듦) 도는 중에 GC 가 돎 — 이게 없으면 재현이 들쭉날쭉
+					for _ = 1, 200 do
+						const _junk = { 1, 2, 3 }
+					end
+					const len = deps[stl.Collection].Len
+					return {
+						Describe = function(v: any): string
+							return `size {len(v)}`
+						end,
+					}
+				end,
+			} :: any
+		)
+		local missing = 0
+		for _, tok in live do
+			if (Describe.impls :: any)[tok] == nil then
+				missing += 1
+			end
+		end
+		assert(missing == 0, `New 가 살아 있는 종류를 건너뜀(판 {round}): {missing}/200`)
+		assert(T.Implements(Describe, stl.Arr.Of(1)) and T.Implements(Describe, stl.HashMap.New()), "내장 종류도")
+		-- 등록이 의존을 채울 때 위로 번지는 길(표식을 돎): 살아 있는 의존 트레이트 사이에 버린 것을 섞음.
+		-- 쓰레기 할당은 재는 순간에만 켬(`pressure`) — 만들 때마다 켜 두면 테스트가 수십 초 걸렸음.
+		local pressure = false
+		local function churn()
+			if pressure then
+				for _ = 1, 1000 do
+					const _junk = { 1, 2, 3 }
+				end
+			end
+		end
+		const Seed = T.New(`Seed{round}`, { required = { "Get" } } :: any)
+		const ups: { any } = {}
+		for i = 1, 100 do
+			ups[i] = T.New(
+				`Up{round}-{i}`,
+				{
+					dependencies = { Seed },
+					defaults = function()
+						churn()
