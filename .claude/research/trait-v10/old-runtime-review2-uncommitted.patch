+	T.Impl(Find, Kind, setmetatable({}, { __index = { IndexOf = fast } }) :: any)
+	const impl: any = T.ImplOf(Find, { __type = Kind })
+	assert(
+		impl.IndexOf() == "fast" and impl.Contains() == "fast",
+		`처음 지을 때: {impl.IndexOf()} {impl.Contains()}`
+	)
+	T.Impl(stl.Stack, Kind, { Push = print } :: any)
+	assert(impl.IndexOf() == "fast" and impl.Contains() == "fast", "다시 지은 뒤에도 같음")
+end
