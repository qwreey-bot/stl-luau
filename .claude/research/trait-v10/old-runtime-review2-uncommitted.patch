+				} :: any
+			)
+		end
+		for _ = 1, 3000 do
+			T.New("DeadUp", { required = { "X" }, dependencies = { Seed } } :: any)
+		end
+		const seeded = T.NewToken(`Seeded{round}`)
+		pressure = true
+		T.Impl(Seed, seeded, { Get = print } :: any)
+		pressure = false
+		local missingUp = 0
