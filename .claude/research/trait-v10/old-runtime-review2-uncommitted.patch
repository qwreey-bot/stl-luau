+const function keysOf(weak: { [any]: any }): (number, { any })
+	local count = 0
+	for _ in weak do
+		count += 1
+	end
+	const list: { any } = table.create(count)
+	local filled = 0
+	for key in weak do
+		if filled == count then
+			break
+		end
+		filled += 1
+		list[filled] = key
+	end
+	return filled, list
+end
